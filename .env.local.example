NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_jRJUeUmDJ9CMONA75QCCCQ_2aCizXnE

# --- Spark AI Live Secrets (Server-Only, never in frontend or NEXT_PUBLIC_*) ---
# 1. Google Gemini 2.5 Flash API Key (for Live Web Grounding & Multi-modal Image/PDF Analysis)
# Get from: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# 2. GPT-OSS 120B API Key (for Timeless Reasoning & Study Explanations)
# Get from: https://console.groq.com -> API Keys
